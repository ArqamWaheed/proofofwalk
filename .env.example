# The relayer's private key, as the JSON array of bytes that
# `Keypair.generate().secretKey` produces. Set this in the Vercel project's
# environment variables — never commit the real value.
#
# The relayer only pays transaction fees. It never signs the memo instruction,
# so it cannot produce an attestation that vouches for a walk.
SOLANA_RELAYER_SECRET=[12,34,...]

# Optional. Defaults to https://api.devnet.solana.com in both the browser and
# the serverless functions.
# SOLANA_RPC_URL=https://api.devnet.solana.com
# VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
